{
    "app-id": "com.idleendeavour.ThingsGNOME",
    "runtime": "org.gnome.Platform",
    "runtime-version": "46",
    "sdk": "org.gnome.Sdk",
    "command": "things-gnome",
    "finish-args": [
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--talk-name=org.freedesktop.secrets"
    ],
    "comment": "network: Things Cloud sync. org.freedesktop.secrets: store the password in the keyring.",
    "modules": [
        {
            "name": "python3-requests",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} requests --no-build-isolation"
            ],
            "sources": [
                {
                    "comment": "Run `flatpak-pip-generator requests keyring` to regenerate these source entries with pinned hashes; placeholders below.",
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/source/r/requests/requests-2.32.3.tar.gz",
                    "sha256": "REPLACE_WITH_REAL_SHA256"
                }
            ]
        },
        {
            "name": "python3-keyring",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} keyring --no-build-isolation"
            ],
            "sources": [
                {
                    "comment": "Regenerate with flatpak-pip-generator; keyring pulls jeepney/SecretStorage on Linux.",
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/source/k/keyring/keyring-25.2.1.tar.gz",
                    "sha256": "REPLACE_WITH_REAL_SHA256"
                }
            ]
        },
        {
            "name": "things-gnome",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --no-index --no-build-isolation --prefix=${FLATPAK_DEST} .",
                "install -Dm644 data/com.idleendeavour.ThingsGNOME.desktop ${FLATPAK_DEST}/share/applications/com.idleendeavour.ThingsGNOME.desktop",
                "install -Dm644 data/com.idleendeavour.ThingsGNOME.metainfo.xml ${FLATPAK_DEST}/share/metainfo/com.idleendeavour.ThingsGNOME.metainfo.xml",
                "install -Dm644 data/icons/hicolor/scalable/apps/com.idleendeavour.ThingsGNOME.svg ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/com.idleendeavour.ThingsGNOME.svg"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
